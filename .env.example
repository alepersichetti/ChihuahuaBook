# Valori da Supabase > Project Settings > API.
# Va bene anche con prefisso NEXT_PUBLIC_ (necessario per il client nel browser).
# Su Vercel l'integrazione Supabase imposta NEXT_PUBLIC_SUPABASE_URL e NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Solo per `npm run db:types`
SUPABASE_PROJECT_ID=<project-ref>

# Chiave della Books API di Google, necessaria per la ricerca su Google Books:
# senza, Google risponde con una quota pari a zero. Se la limiti, usa "Siti web"
# con l'indirizzo dell'app: il server lo invia come referrer.
GOOGLE_BOOKS_API_KEY=
